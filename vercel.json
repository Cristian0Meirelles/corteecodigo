{
  "rewrites": [
    {
      "source": "/cortes",
      "destination": "/"
    },
    {
      "source": "/cortes.html",
      "destination": "/"
    },
    {
      "source": "/((?!assets/|favicon.ico|demo/).*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/demo/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}